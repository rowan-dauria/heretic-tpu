# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# Caches
/.ruff_cache/
/.pytest_cache/

# Optional local checkout of upstream Heretic (p-e-w/heretic), which the tests that
# compare with upstream read when it is present
/heretic/

# Throwaway scripts (synced to the TPU VM by scripts/tpu.sh)
/.scratch/

# Editors
/.vscode/
/.idea/

# Configuration file (root only, not ignored in test directories)
/config.toml

# Study checkpoints
checkpoints/

# Residual plots
plots/

# Models generated by tests
/tests/*/model/
